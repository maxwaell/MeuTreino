<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Treino de outubro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eef2f8; --surface:#ffffff; --surface2:#e5ebf4; --ink:#0e1a2b; --mute:#566680;
  --line:#d3dcea; --accent:#1d6fe0; --ok:#12a37a;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0c1626; --surface:#142238; --surface2:#1b2d49; --ink:#eaf1fb; --mute:#92a6c2;
    --line:#26395a; --accent:#4aa3ff; --ok:#3ddc97;
  }
}
:root[data-theme="dark"]{
  --bg:#0c1626; --surface:#142238; --surface2:#1b2d49; --ink:#eaf1fb; --mute:#92a6c2;
  --line:#26395a; --accent:#4aa3ff; --ok:#3ddc97;
}
html{background:var(--bg);scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.4 'Barlow',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
button{font-family:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:480px;margin:0 auto;padding:18px 14px 48px}

/* cabeçalho */
.top{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
h1{margin:0;font:700 60px/.85 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.5px}
.yr{font:600 20px 'Barlow Condensed',sans-serif;color:var(--mute);margin-left:6px}
.sum{font-size:14px;color:var(--mute);text-align:right;line-height:1.25}
.sum b{display:block;font:700 28px/1 'Barlow Condensed',sans-serif;color:var(--ink)}

/* calendário */
.dow,.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.dow{margin:18px 0 6px}
.dow span{text-align:center;font-size:12px;font-weight:600;color:var(--mute)}
.cell{display:flex;flex-direction:column;align-items:center;gap:2px;min-height:60px;padding:6px 3px;
  background:var(--surface);border:1px solid var(--line);border-radius:10px;color:var(--ink)}
.cell .dn{font:700 21px/1 'Barlow Condensed',sans-serif}
.cell .tg{font-size:10px;color:var(--mute);line-height:1.1;white-space:nowrap}
.cell .bar{margin-top:auto;width:100%;height:4px;border-radius:2px;background:var(--surface2);overflow:hidden}
.cell .bar i{display:block;height:100%;background:var(--c)}
.cell.today{border-color:var(--accent)}
.cell.today .dn{color:var(--accent)}
.cell.sel{background:var(--surface2);border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c)}
.cell.full .dn::after{content:"\2713";font-size:12px;margin-left:2px;color:var(--ok)}

/* dia selecionado */
#detail{margin-top:26px}
.dh{display:flex;align-items:flex-end;gap:14px}
.big{font:700 84px/.78 'Barlow Condensed',sans-serif;color:var(--c);min-width:62px}
.dh .wd{font-size:14px;color:var(--mute)}
.dh .tt{font:700 30px/1 'Barlow Condensed',sans-serif;margin:2px 0}
.dh .fc{font-size:15px;color:var(--mute)}
.note{margin:14px 0 0;padding:6px 12px;border-left:3px solid var(--c);color:var(--mute);font-size:14px}
.prog{display:flex;align-items:center;gap:10px;margin-top:16px}
.track{flex:1;height:8px;border-radius:4px;background:var(--surface2);overflow:hidden}
.track i{display:block;height:100%;background:var(--c);width:0;transition:width .2s}
.ptxt{font-size:14px;font-weight:600;min-width:52px;text-align:right}
.pill{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 14px;font-size:14px;font-weight:600}
.pill:active{background:var(--surface2)}

/* itens */
.item{margin-top:10px;background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden}
.item.done{border-color:var(--c)}
.ih{display:grid;grid-template-columns:52px 1fr 36px;align-items:center}
.chk{width:34px;height:34px;margin:0 0 0 12px;border-radius:50%;border:2px solid var(--c);background:transparent;display:grid;place-items:center;padding:0}
.chk svg{width:18px;height:18px;opacity:0}
.item.done .chk{background:var(--c)}
.item.done .chk svg{opacity:1}
.main{background:none;border:0;text-align:left;padding:13px 6px;min-width:0}
.main .nm{display:block;font-size:17px;font-weight:600;line-height:1.2}
.item.done .nm{color:var(--mute);text-decoration:line-through;text-decoration-thickness:1px}
.main .mt{display:block;font-size:13px;color:var(--mute);margin-top:2px}
.main .mt b{color:var(--ink);font-weight:600}
.main .last{display:block;font-size:12.5px;color:var(--accent);margin-top:2px;font-weight:500}
.chev{width:20px;height:20px;justify-self:center;transition:transform .15s;color:var(--mute)}
.item.open .chev{transform:rotate(180deg)}
.nochev{width:20px}

.sets{padding:2px 12px 14px;border-top:1px solid var(--line)}
.srow{display:grid;grid-template-columns:30px 1fr 1fr 46px;gap:8px;align-items:center;margin-top:8px}
.shead{margin-top:10px;font-size:12px;color:var(--mute);text-align:center;font-weight:600}
.sn{font:700 20px 'Barlow Condensed',sans-serif;color:var(--mute);text-align:center}
.sets input{width:100%;height:46px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--ink);
  text-align:center;font:600 18px 'Barlow',sans-serif;padding:0 6px}
.sets input::placeholder{color:var(--mute);opacity:.55;font-weight:400}
.sc{width:46px;height:46px;border-radius:12px;border:2px solid var(--line);background:transparent;display:grid;place-items:center;padding:0}
.sc svg{width:20px;height:20px;opacity:0}
.sc.on{background:var(--ok);border-color:var(--ok)}
.sc.on svg{opacity:1}
.sbtns{display:flex;gap:8px;margin-top:12px}
.cardio{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:2px 12px 14px;border-top:1px solid var(--line)}
.cardio label{font-size:12px;color:var(--mute);font-weight:600;display:block;margin-top:10px}
.cardio input{margin-top:4px;width:100%;height:46px;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--ink);text-align:center;font:600 18px 'Barlow',sans-serif}
.foot{margin-top:28px;font-size:12.5px;color:var(--mute);text-align:center}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>Outubro<span class="yr">2026</span></h1>
    <div class="sum" id="sum"></div>
  </div>
  <div class="dow" id="dow"></div>
  <div class="grid" id="grid"></div>
  <section id="detail" aria-live="polite"></section>
  <p class="foot" id="foot"></p>
</div>

<script>
/* ---------- Plano ---------- */
// cada exercício: [nome, séries, repetições, músculo]
const CYCLE = [
  { name:'Full body A', focus:'Ênfase em peito', tag:'Peito', color:'#3b8cf0',
    note:'Dia de 10 km: deixe 1-2 repetições de reserva nas pernas e faça a esteira depois, em ritmo confortável.',
    cardio:'Esteira 10 km', ex:[
    ['Supino inclinado barra guiada',3,'10','Peito'],
    ['Supino reto máquina',3,'10-12','Peito'],
    ['Crucifixo máquina',3,'12','Peito'],
    ['Puxada alta supinada',3,'10-12','Costas'],
    ['Remada máquina pronado',3,'12','Costas'],
    ['Desenvolvimento máquina',2,'12','Ombro'],
    ['Leg press',3,'12','Coxa'],
    ['Elevação pélvica',3,'12','Glúteo'],
    ['Rosca Scott máquina',2,'12','Bíceps'],
    ['Tríceps polia',2,'12','Tríceps']]},
  { name:'Full body B', focus:'Ênfase em glúteo e coxa', tag:'Glúteo', color:'#f2694a',
    note:'Aqueça 5 min e faça 30 min de esteira depois do treino.',
    cardio:'Esteira 30 min', ex:[
    ['Agachamento barra guiada',3,'10','Coxa'],
    ['Elevação pélvica',4,'10','Glúteo'],
    ['Leg press pés altos',3,'12','Glúteo'],
    ['Cadeira flexora',3,'12','Posterior'],
    ['Cadeira abdutora',3,'15','Glúteo'],
    ['Supino reto máquina',2,'12','Peito'],
    ['Remada baixa na polia',3,'12','Costas'],
    ['Elevação lateral na polia',3,'15','Ombro'],
    ['Rosca direta na polia',2,'12','Bíceps'],
    ['Abdominal máquina',3,'15','Abdômen']]},
  { name:'Alongamento', focus:'Mobilidade e cardio leve', tag:'Along.', color:'#8068f0', cardioFirst:true,
    note:'Esteira leve de 10 km primeiro, depois 15-20 min de alongamento. Chegue inteiro ao treino pesado de domingo.',
    cardio:'Esteira 10 km (ritmo leve)', kind:'stretch', ex:[
    ['Alongamento arco',0,'30 s','Peito e ombro'],
    ['Alongamento de peito unilateral no espaldar',0,'30 s cada lado','Peito'],
    ['Alongamento suspensão nº1',0,'30 s','Espaldar'],
    ['Alongamento suspensão nº3',0,'30 s','Espaldar'],
    ['Mobilidade gato e vaca',0,'10 repetições','Coluna'],
    ['Alongamento borboleta',0,'30 s','Quadril'],
    ['Alongamento posterior de coxa sentado',0,'30 s cada lado','Posterior'],
    ['Alongamento de iliopsoas nº2',0,'30 s cada lado','Quadril'],
    ['Mobilidade W nº1',0,'10 repetições','Ombro']]},
  { name:'Full body pesado', focus:'Cargas altas, poucas repetições', tag:'Pesado', color:'#e8a317',
    note:'Descanse mais entre as séries (2-3 min nos básicos). Esteira de 30 min depois.',
    cardio:'Esteira 30 min', ex:[
    ['Agachamento barra guiada',4,'6-8','Coxa'],
    ['Elevação pélvica',4,'8','Glúteo'],
    ['Leg press',3,'8','Coxa'],
    ['Supino inclinado barra guiada',4,'6-8','Peito'],
    ['Puxada alta supinada',4,'8','Costas'],
    ['Remada cavalinho',3,'8','Costas'],
    ['Desenvolvimento máquina',3,'8','Ombro'],
    ['Rosca Scott máquina',3,'8-10','Bíceps'],
    ['Tríceps polia',3,'8-10','Tríceps'],
    ['Abdominal máquina',3,'12','Abdômen']]},
  { name:'Full body C', focus:'Ênfase em costas e ombro', tag:'Costas', color:'#1fb89f',
    note:'Dia de 10 km: deixe 1-2 repetições de reserva e faça a esteira depois, em ritmo confortável.',
    cardio:'Esteira 10 km', ex:[
    ['Puxada alta supinada',3,'10','Costas'],
    ['Remada cavalinho',3,'10','Costas'],
    ['Remada baixa na polia',3,'12','Costas'],
    ['Crucifixo invertido na máquina',3,'12','Ombro'],
    ['Desenvolvimento máquina',3,'10','Ombro'],
    ['Elevação lateral na polia',3,'15','Ombro'],
    ['Cross-over na polia',2,'12','Peito'],
    ['Elevação pélvica',3,'12','Glúteo'],
    ['Rosca Scott máquina',2,'12','Bíceps'],
    ['Tríceps coice na polia',2,'12','Tríceps']]},
  { name:'Full body D', focus:'Ênfase em coxa e glúteo', tag:'Coxa', color:'#e8559a',
    note:'Aqueça 5 min e faça 30 min de esteira depois do treino.',
    cardio:'Esteira 30 min', ex:[
    ['Elevação pélvica pesada',4,'8-10','Glúteo'],
    ['Leg press',4,'10-12','Coxa'],
    ['Cadeira extensora',3,'12-15','Coxa'],
    ['Cadeira flexora',3,'12','Posterior'],
    ['Búlgaro na barra guiada',3,'10','Coxa e glúteo'],
    ['Cadeira abdutora',3,'15','Glúteo'],
    ['Crucifixo máquina',3,'12','Peito'],
    ['Remada máquina pronado',3,'12','Costas'],
    ['Rosca direta na polia',2,'12','Bíceps'],
    ['Abdominal máquina',3,'15','Abdômen']]},
  { name:'Pilates', focus:'Dia de recuperação', tag:'Pilates', color:'#8a97aa',
    note:'Sem esteira hoje. Descanse e priorize o sono.',
    kind:'simple', ex:[['Aula de pilates',0,'1 aula','Recuperação']]}
];
const WEEKDAYS = ['Quinta','Sexta','Sábado','Domingo','Segunda','Terça','Quarta'];
const DOW_SHORT = ['Qui','Sex','Sáb','Dom','Seg','Ter','Qua'];
const DAYS = 31;

/* ---------- Estado e armazenamento ---------- */
const STORE_KEY = 'treino-outubro-2026';
let storageOK = true;
let S = { logs:{} };
try {
  const raw = localStorage.getItem(STORE_KEY);
  if (raw) { const p = JSON.parse(raw); if (p && p.logs) S = p; }
} catch (e) { storageOK = false; }
function save(){
  try { localStorage.setItem(STORE_KEY, JSON.stringify(S)); }
  catch (e) { storageOK = false; renderFoot(); }
}

const pad = n => String(n).padStart(2,'0');
const dkey = d => '2026-10-' + pad(d);
const now = new Date();
const inOct = now.getFullYear() === 2026 && now.getMonth() === 9;
const todayD = inOct ? now.getDate() : 0;
let sel = inOct ? todayD : 1;
const open = new Set();

/* ---------- Itens do dia ---------- */
function cycleOf(d){ return CYCLE[(d-1) % 7]; }
function items(d){
  const c = cycleOf(d), list = [];
  const cardio = c.cardio ? { id:'c', kind:'cardio', name:c.cardio, sets:0, reps:'', muscle:'Cardio' } : null;
  if (cardio && c.cardioFirst) list.push(cardio);
  c.ex.forEach((e,i)=> list.push({ id:'e'+i, kind:c.kind||'ex', name:e[0], sets:e[1], reps:e[2], muscle:e[3] }));
  if (cardio && !c.cardioFirst) list.push(cardio);
  return list;
}
const newSets = n => Array.from({length:n}, () => ({ r:'', k:'', d:false }));
function peek(dk,id){ return (S.logs[dk] && S.logs[dk][id]) || null; }
function entry(dk,it){
  const L = S.logs[dk] || (S.logs[dk] = {});
  let e = L[it.id];
  if (!e){ e = { n:it.name, done:false }; if (it.sets) e.sets = newSets(it.sets); L[it.id] = e; }
  return e;
}
function stats(d){
  const its = items(d), dk = dkey(d);
  const done = its.filter(it => { const e = peek(dk,it.id); return e && e.done; }).length;
  return { done, total: its.length };
}
function lastFor(name, dk){
  const keys = Object.keys(S.logs).filter(k => k < dk).sort().reverse();
  for (const k of keys){
    for (const id in S.logs[k]){
      const e = S.logs[k][id];
      if (e.n === name && e.sets){
        const w = e.sets.filter(s => s.k !== '');
        if (w.length){ const s = w[w.length-1]; return (s.r ? s.r + ' × ' : '') + s.k + ' kg'; }
      }
    }
  }
  return null;
}
const esc = s => String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12.5 10 18 20 6.5"/></svg>';
const CHEV = '<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';

/* ---------- Render ---------- */
function renderTop(){
  document.getElementById('dow').innerHTML = DOW_SHORT.map(d => '<span>'+d+'</span>').join('');
  let full = 0;
  for (let d=1; d<=DAYS; d++){ const s = stats(d); if (s.done === s.total) full++; }
  document.getElementById('sum').innerHTML = '<b>'+full+' de '+DAYS+'</b>dias concluídos';
}
function renderCal(){
  let h = '';
  for (let d=1; d<=DAYS; d++){
    const c = cycleOf(d), s = stats(d);
    const pct = Math.round(100 * s.done / s.total);
    const cls = ['cell', d===sel?'sel':'', d===todayD?'today':'', s.done===s.total?'full':''].join(' ');
    h += '<button class="'+cls+'" data-act="sel" data-d="'+d+'" style="--c:'+c.color+'" aria-label="Dia '+d+', '+c.name+', '+s.done+' de '+s.total+' feitos">'
       + '<span class="dn">'+d+'</span><span class="tg">'+c.tag+'</span><span class="bar"><i style="width:'+pct+'%"></i></span></button>';
  }
  document.getElementById('grid').innerHTML = h;
}
function itemHTML(it, dk){
  const e = peek(dk,it.id) || { done:false, sets: it.sets ? newSets(it.sets) : null };
  const key = dk + it.id;
  const isOpen = open.has(key);
  const expandable = it.sets > 0 || it.kind === 'cardio';
  let meta = '';
  if (it.kind === 'ex') meta = '<b>'+it.sets+'x'+it.reps+'</b> '+esc(it.muscle);
  else if (it.kind === 'stretch') meta = '<b>'+esc(it.reps)+'</b> '+esc(it.muscle);
  else if (it.kind === 'cardio') meta = 'Depois do treino, sem pressa';
  else meta = '<b>'+esc(it.reps)+'</b>';
  if (it.kind === 'cardio' && cycleOf(+dk.slice(-2)).cardioFirst) meta = 'Antes do alongamento';
  const last = it.kind === 'ex' ? lastFor(it.name, dk) : null;
  let h = '<div class="item'+(e.done?' done':'')+(isOpen?' open':'')+'">'
    + '<div class="ih">'
    + '<button class="chk" data-act="done" data-id="'+it.id+'" aria-label="Marcar '+esc(it.name)+' como feito" aria-pressed="'+!!e.done+'">'+CHECK+'</button>'
    + (expandable
        ? '<button class="main" data-act="open" data-id="'+it.id+'" aria-expanded="'+isOpen+'">'
        : '<button class="main" data-act="done" data-id="'+it.id+'">')
    + '<span class="nm">'+esc(it.name)+'</span><span class="mt">'+meta+'</span>'
    + (last ? '<span class="last">Última vez: '+esc(last)+'</span>' : '')
    + '</button>'
    + (expandable ? CHEV : '<span class="nochev"></span>')
    + '</div>';
  if (isOpen && it.kind === 'cardio'){
    h += '<div class="cardio"><div><label for="km'+it.id+'">Distância (km)</label><input id="km'+it.id+'" inputmode="decimal" data-f="km" data-id="'+it.id+'" value="'+esc(e.km||'')+'" placeholder="10"></div>'
       + '<div><label for="mn'+it.id+'">Tempo (min)</label><input id="mn'+it.id+'" inputmode="numeric" data-f="min" data-id="'+it.id+'" value="'+esc(e.min||'')+'" placeholder="30"></div></div>';
  }
  if (isOpen && it.sets > 0){
    h += '<div class="sets"><div class="srow shead"><span>Série</span><span>Repetições</span><span>Carga (kg)</span><span>Feito</span></div>';
    (e.sets || []).forEach((s,i) => {
      h += '<div class="srow"><span class="sn">'+(i+1)+'</span>'
        + '<input inputmode="numeric" aria-label="Repetições da série '+(i+1)+'" data-f="r" data-id="'+it.id+'" data-i="'+i+'" value="'+esc(s.r)+'" placeholder="'+esc(it.reps)+'">'
        + '<input inputmode="decimal" aria-label="Carga da série '+(i+1)+'" data-f="k" data-id="'+it.id+'" data-i="'+i+'" value="'+esc(s.k)+'" placeholder="kg">'
        + '<button class="sc'+(s.d?' on':'')+'" data-act="sdone" data-id="'+it.id+'" data-i="'+i+'" aria-label="Série '+(i+1)+' feita" aria-pressed="'+!!s.d+'">'+CHECK+'</button></div>';
    });
    h += '<div class="sbtns"><button class="pill" data-act="addset" data-id="'+it.id+'">+ Série</button>'
       + ((e.sets||[]).length > 1 ? '<button class="pill" data-act="delset" data-id="'+it.id+'">− Série</button>' : '')
       + '</div></div>';
  }
  return h + '</div>';
}
function renderDetail(){
  const c = cycleOf(sel), dk = dkey(sel), its = items(sel), s = stats(sel);
  const pct = Math.round(100 * s.done / s.total);
  let h = '<div class="dh" style="--c:'+c.color+'"><div class="big">'+pad(sel)+'</div><div>'
    + '<div class="wd">'+WEEKDAYS[(sel-1)%7]+', '+sel+' de outubro'+(sel===todayD?' (hoje)':'')+'</div>'
    + '<div class="tt">'+c.name+'</div><div class="fc">'+c.focus+'</div></div></div>'
    + '<p class="note" style="--c:'+c.color+'">'+c.note+'</p>'
    + '<div class="prog" style="--c:'+c.color+'"><div class="track"><i id="pfill" style="width:'+pct+'%"></i></div>'
    + '<span class="ptxt" id="ptxt">'+s.done+' de '+s.total+'</span>'
    + '<button class="pill" id="allbtn" data-act="all">'+(s.done===s.total?'Desmarcar todos':'Marcar todos')+'</button></div>'
    + '<div style="--c:'+c.color+'">';
  its.forEach(it => { h += itemHTML(it, dk); });
  h += '</div>';
  document.getElementById('detail').innerHTML = h;
}
function updateProgress(){
  const c = cycleOf(sel), s = stats(sel);
  const f = document.getElementById('pfill'), t = document.getElementById('ptxt'), b = document.getElementById('allbtn');
  if (f) f.style.width = Math.round(100*s.done/s.total) + '%';
  if (t) t.textContent = s.done + ' de ' + s.total;
  if (b) b.textContent = s.done === s.total ? 'Desmarcar todos' : 'Marcar todos';
}
function renderFoot(){
  document.getElementById('foot').textContent = storageOK
    ? 'Os registros ficam salvos neste aparelho.'
    : 'Este navegador não permite salvar: os registros somem ao fechar a página.';
}
function renderAll(){ renderTop(); renderCal(); renderDetail(); }

/* ---------- Eventos ---------- */
const find = id => items(sel).find(x => x.id === id);
function recalcDone(e){ if (e.sets && e.sets.length) e.done = e.sets.every(s => s.d); }

document.addEventListener('click', ev => {
  const t = ev.target.closest('[data-act]');
  if (!t) return;
  const act = t.dataset.act, id = t.dataset.id, i = +t.dataset.i, dk = dkey(sel);
  if (act === 'sel'){
    sel = +t.dataset.d;
    renderCal(); renderDetail();
    document.getElementById('detail').scrollIntoView({ behavior:'smooth', block:'start' });
    return;
  }
  if (act === 'all'){
    const its = items(sel), allDone = stats(sel).done === its.length;
    its.forEach(it => { const e = entry(dk,it); e.done = !allDone; if (e.sets) e.sets.forEach(s => s.d = !allDone); });
  } else {
    const it = find(id); if (!it) return;
    if (act === 'open'){
      const k = dk + id; open.has(k) ? open.delete(k) : open.add(k);
      renderDetail(); return;
    }
    const e = entry(dk,it);
    if (act === 'done'){ e.done = !e.done; if (e.sets) e.sets.forEach(s => s.d = e.done); }
    else if (act === 'sdone'){ e.sets[i].d = !e.sets[i].d; recalcDone(e); }
    else if (act === 'addset'){ e.sets.push({ r:'', k:'', d:false }); recalcDone(e); }
    else if (act === 'delset'){ if (e.sets.length > 1){ e.sets.pop(); recalcDone(e); } }
  }
  save(); renderTop(); renderCal(); renderDetail();
});

document.addEventListener('input', ev => {
  const t = ev.target, f = t.dataset && t.dataset.f;
  if (!f) return;
  const it = find(t.dataset.id); if (!it) return;
  const e = entry(dkey(sel), it);
  if (f === 'r' || f === 'k') e.sets[+t.dataset.i][f] = t.value;
  else e[f] = t.value;
  save();
});

renderAll(); renderFoot();
</script>
</body>
</html>
